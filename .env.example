# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (bouton « Connect », ou Project Settings → API Keys). Voir docs/installation.md.
# Ces deux valeurs sont publiques par nature : elles sont envoyées au navigateur.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Ne jamais ajouter ici la clé secrète (sb_secret_…) ni le mot de passe de la base.

# Facultatif : « memoire » pour travailler sans Supabase. Les dépôts démarrent
# avec la base d'exemple de supabase/seed.sql, perdue à chaque rechargement.
# VITE_DONNEES=memoire
